# Optional local PostgreSQL-compatible store. Default is local data/pglite.
# DATABASE_URL=pglite:./data/pglite
# Production: persistent PostgreSQL is REQUIRED; never deploy local PGlite.
# DATABASE_URL=postgres://user:password@host:5432/chaos?sslmode=require
# Generate a stable random secret in the hosting environment. Never commit it.
# BETTER_AUTH_SECRET=<random-secret-at-least-32-characters>
# BETTER_AUTH_URL=https://your-authorized-host.example
# PORT=8080
# No paid model key is required for operational workflows.
# Optional local Ollama provider endpoint; select its engine/model in Settings.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# For a self-hosted Ollama-only launch (pnpm dev:ollama sets these for its child):
# AGENT_ENGINE=ai-sdk:ollama
# AGENT_MODEL=qwen3:1.7b
